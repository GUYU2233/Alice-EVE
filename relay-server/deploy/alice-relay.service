[Unit]
Description=Alice Eve Relay (generic example)
After=network.target

[Service]
# Replace paths in a private host-managed unit; do not commit host details.
User=alice-relay
Group=alice-relay
ExecStart=/usr/local/libexec/alice-relay/relay-server
Environment=LISTEN_ADDR=127.0.0.1:18443
EnvironmentFile=-/run/credentials/alice-relay.env
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectKernelModules=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/alice-relay
UMask=0077

[Install]
WantedBy=multi-user.target
