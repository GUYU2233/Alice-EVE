# Copy this file to an untracked secret location before deployment.
# Never commit the copied file or place credentials in unit files.
# Values below are deliberately non-functional placeholders.

# Bind only to loopback; expose HTTPS through a separately managed reverse proxy.
LISTEN_ADDR=127.0.0.1:18443

# PostgreSQL DSN supplied by a secret manager or protected EnvironmentFile.
# Use a dedicated database and least-privileged role; require TLS in production.
DATABASE_URL=postgres://relay_user:CHANGE_ME@db.internal.invalid:5432/relay?sslmode=verify-full

# Startup migration policy. `apply` (default) acquires a PostgreSQL advisory lock,
# verifies checksums, and stops/rolls back on the first failure. Use `dry-run` to
# inspect pending migrations without writes; use `off` only when deployment runs
# the same migration runner as a separate step.
MIGRATIONS_MODE=apply

# Public origin used for redirects/links. Replace with an operator-owned HTTPS origin.
PUBLIC_BASE_URL=https://relay.example.invalid

# Keep logs structured and free of authorization headers, tokens, DSNs, and payloads.
LOG_LEVEL=info

# Optional deployment controls; set these in the secret manager, not in Git.
# TRUSTED_PROXY_CIDRS=REPLACE_WITH_PROXY_CIDRS
# CORS_ALLOWED_ORIGINS=https://relay.example.invalid

# EVE SSO public OAuth client configuration. Never add a client secret here.
# Endpoints must be HTTPS and values should be injected by the config manager.
# EVE_SSO_AUTHORIZATION_ENDPOINT=https://login.eveonline.com/v2/oauth/authorize
# EVE_SSO_TOKEN_ENDPOINT=https://login.eveonline.com/v2/oauth/token
# EVE_SSO_USERINFO_ENDPOINT=https://login.eveonline.com/oauth/verify
# EVE_SSO_CLIENT_ID=PUBLIC_CLIENT_ID
# EVE_SSO_REDIRECT_URI=https://relay.example.invalid/api/v1/auth/sso/callback
# Optional exact deep-link target after browser login; never accept request-supplied URLs.
# EVE_SSO_DEEP_LINK_URI=alice-eve://oauth/callback
# EVE_SSO_SCOPES=esi-location.read_location.v1

# Firebase Cloud Messaging HTTP v1 (optional). These are non-secret controls only.
# Enable only after an FCMAccessTokenSource and FCMTokenResolver are wired by the
# deployment. Credentials must come from workload identity/Secret Manager; do
# not set GOOGLE_APPLICATION_CREDENTIALS, service-account JSON, or access tokens.
# FCM_ENABLED=true
# FCM_PROJECT_ID=eve-prod
# FCM_TIMEOUT=8s
# FCM_MAX_ATTEMPTS=3
# FCM_INITIAL_BACKOFF=200ms
# FCM_ENDPOINT=https://fcm.googleapis.com
# FCM_ACCESS_TOKEN is intentionally unsupported.
